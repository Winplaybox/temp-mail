# Python API (Render). No trailing slash.
NEXT_PUBLIC_API_URL=https://wpb-temp-mail-api.onrender.com

# Supabase — anon key is only used to listen for "new mail" pings (no data access).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (for SEO tags + sitemap)
NEXT_PUBLIC_SITE_URL=https://temp-mail.winplaybox.in

# Optional: Google AdSense client id, e.g. ca-pub-2699537002342677
NEXT_PUBLIC_ADSENSE_CLIENT=

# Local only: shows a "Send test mail" button (needs backend DEV_MODE=1)
NEXT_PUBLIC_DEV=
