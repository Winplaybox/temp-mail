# ---- server only (Hostinger → Node.js → Environment variables) ----
SUPABASE_URL=https://xatbfyiytcnogfbtfsym.supabase.co
SUPABASE_ANON_KEY=               # publishable/anon key — data is only reachable with the server secret below
TEMPMAIL_SERVER_SECRET=          # its sha256 is stored in public.tm_config (server_secret_sha256)
TEMPMAIL_INGEST_SECRET=          # last path part of the ForwardEmail webhook URL: /api/ingest/<secret>
TEMPMAIL_IP_SALT=                # random string, used to hash IPs for rate limits
TEMPMAIL_CREATE_PER_HOUR=15

# ---- browser (baked in at build time) ----
NEXT_PUBLIC_SUPABASE_URL=https://xatbfyiytcnogfbtfsym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # same anon key; only used to hear "new mail" pings
NEXT_PUBLIC_SITE_URL=https://temp-mail.winplaybox.in
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---- local development without Supabase ----
# TEMPMAIL_DEV_MEMORY=1
# NEXT_PUBLIC_DEV=1
